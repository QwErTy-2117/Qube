# ─── Composio API Key ────────────────────────────────────────────────────────
# Required for external service connectors (Slack, GitHub, Gmail, etc.).
# Get your API key at https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# ─── Login with ChatGPT ─────────────────────────────────────────────────────
# Secret for signing ChatGPT session cookies (stable across deploys, rotation logs everyone out).
# Generate with: openssl rand -hex 32
# If unset, a dev secret is auto-persisted to .memory/lwc-secret.txt
LWC_SECRET=

# Codex client version used for ChatGPT model discovery (optional).
# Qube refreshes this from the latest @openai/codex release automatically;
# set it only to pin/override a version.
# LWC_CLIENT_VERSION=0.163.0

# Fallback model for ChatGPT requests that omit one (optional).
# LWC_DEFAULT_MODEL=gpt-6-luna

# ─── OpenUI generative UI ────────────────────────────────────────────────────
# OpenUI (https://www.openui.com/) renders model-generated cards, tables,
# charts, and forms inline in chat. Enabled by default; set to false to keep
# plain Markdown + the generate_ui sandbox only.
# OPENUI_ENABLED=false

# ─── Browser backend ─────────────────────────────────────────────────────────
# Qube's browser is Chromium over the Chrome DevTools Protocol (CDP) — the
# same backend the OpenBot browser uses. The packaged app bundles its own
# Chromium (sidecar-dist/browser/chromium) so no separate Chrome/Edge install
# is needed; set CHROME_PATH to override the binary. By default Qube
# launches/adopts Chromium on BROWSER_CDP_PORT (9222). To instead attach to an
# already running Chromium (e.g. the OpenBot browser) and drive that same
# instance, set its DevTools endpoint here. Qube never launches or kills an
# external browser; it only attaches over CDP.
# CHROME_PATH=/path/to/chrome
# BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
# BROWSER_CDP_PORT=9222
