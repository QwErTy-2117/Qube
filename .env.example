# ─── Composio API Key ────────────────────────────────────────────────────────
# Required for external service connectors (Slack, GitHub, Gmail, etc.).
# Get your API key at https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# ─── Login with ChatGPT ─────────────────────────────────────────────────────
# Secret for signing ChatGPT session cookies (stable across deploys, rotation logs everyone out).
# Generate with: openssl rand -hex 32
# If unset, a dev secret is auto-persisted to .memory/lwc-secret.txt
LWC_SECRET=

# ─── OpenUI generative UI ────────────────────────────────────────────────────
# OpenUI (https://www.openui.com/) renders model-generated cards, tables,
# charts, and forms inline in chat. Enabled by default; set to false to keep
# plain Markdown + the generate_ui sandbox only.
# OPENUI_ENABLED=false
