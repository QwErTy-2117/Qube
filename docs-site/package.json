{
  "name": "qube-docs",
  "private": true,
  "description": "Documentation website for Qube (Fumadocs, static export for GitHub Pages). Isolated from the Qube app.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && next dev -p 3020",
    "build": "node scripts/sync-content.mjs && next build",
    "check-links": "node scripts/check-links.mjs",
    "preview": "serve out -l 3020"
  },
  "dependencies": {
    "fumadocs-core": "16.19.5",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.5",
    "lucide-react": "^1.71.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.32",
    "serve": "^14.2.7",
    "tailwindcss": "^4.3.5"
  }
}
