{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Qube",
  "version": "0.0.33",
  "identifier": "com.qube.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "node scripts/build-sidecar.js",
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "title": "Qube",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "createUpdaterArtifacts": true,
    "resources": [
      "../sidecar-dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQjQ5RjlGNDg2Rjk4QkMKUldTOG1HOUluNSswbkNuOWdWTHJuZXlrRkJMSE8zTEY0WVllSU9qN05XSjhwV1ZKTkdJcDBzRlIK",
      "endpoints": [
        "https://github.com/QwErTy-2117/Qube/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
