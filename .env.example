# ─── OpenCode Zen API Key ──────────────────────────────────────────────────────
# Required for Qube built-in models (Muse Spark 1.2 Free, Nemotron 3.5 Free).
# Sign up at https://opencode.ai/auth and copy your API key.
# For prod/Vercel: set this as OPENCODE_API_KEY in your environment secrets.
OPENCODE_API_KEY=

# ─── Composio API Key ────────────────────────────────────────────────────────
# Required for external service connectors (Slack, GitHub, Gmail, etc.).
# Get your API key at https://dashboard.composio.dev/settings
COMPOSIO_API_KEY=

# ─── Login with ChatGPT ─────────────────────────────────────────────────────
# Secret for signing ChatGPT session cookies (stable across deploys, rotation logs everyone out).
# Generate with: openssl rand -hex 32
# If unset, a dev secret is auto-persisted to .memory/lwc-secret.txt
LWC_SECRET=
